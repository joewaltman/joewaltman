  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "drizzle-kit": "0.31.11"
  }
}
